# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Port the API listens on
PORT=4000

# Runtime mode: development | production
NODE_ENV=development

# Database connection string.
# Local (a mongod you started yourself):
MONGODB_URI=mongodb://127.0.0.1:27017/arch_portfolio
# MongoDB Atlas (production) looks like:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/arch_portfolio?retryWrites=true&w=majority

# Secret used to sign JWTs. Must be a long random string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long an access token stays valid (now/1h/7d style)
JWT_EXPIRES_IN=1h

# bcrypt work factor. 12 is a good 2026 default.
BCRYPT_ROUNDS=12

# Comma-separated list of origins allowed to call this API (the React app)
CLIENT_ORIGIN=http://localhost:5173
